<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>CFBundleDisplayName</key>
    <string>Twinzo Scan</string>
    <key>CFBundleShortVersionString</key>
    <string>0.1.0</string>

    <key>NSCameraUsageDescription</key>
    <string>Twinzo Scan uses the camera and LiDAR scanner to capture as-built geometry and compare it against your BIM model.</string>

    <!-- Require LiDAR at the App Store level: the app has no meaningful
         degraded mode without a depth sensor. -->
    <key>UIRequiredDeviceCapabilities</key>
    <array>
        <string>arm64</string>
        <string>arkit</string>
        <string>iphone-ipad-minimum-performance-a12</string>
    </array>

    <!-- Full-screen-only: correct for an AR scanning session and it lets the
         app legitimately skip the upside-down orientation on iPad. -->
    <key>UIRequiresFullScreen</key>
    <true/>

    <!-- Launch screen storyboard (required for App Store submission). -->
    <key>UILaunchStoryboardName</key>
    <string>LaunchScreen</string>

    <key>UISupportedInterfaceOrientations</key>
    <array>
        <string>UIInterfaceOrientationPortrait</string>
        <string>UIInterfaceOrientationLandscapeLeft</string>
        <string>UIInterfaceOrientationLandscapeRight</string>
    </array>

    <!-- Models arrive from Files, AirDrop or a twin backend rather than the
         bundle, so the app has to be able to open them in place. -->
    <key>UIFileSharingEnabled</key>
    <true/>
    <key>LSSupportsOpeningDocumentsInPlace</key>
    <true/>
</dict>
</plist>
